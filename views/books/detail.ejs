<!DOCTYPE html>
<html lang="es" data-base-url="<%= baseUrl || '' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Detalle del libro' %></title>
    <link rel="preconnect" href="http://fonts.googleapis.com">
    <link rel="preconnect" href="http://fonts.gstatic.com" crossorigin>
    <link href="http://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="http://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="http://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="<%= baseUrl || '' %>/css/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="main-shell">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <a href="<%= baseUrl || '' %>/books/catalog" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Volver al catálogo</a>
            </div>

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card overflow-hidden">
                        <% const imageUrl = book.images && book.images.length ? book.images[0].image_url : ''; const imageSrc = imageUrl && /^https?:\/\//i.test(imageUrl) ? imageUrl.replace(/^https:/i, 'http:') : imageUrl ? `${baseUrl || ''}${imageUrl.startsWith('/') ? '' : '/'}${imageUrl}` : `${baseUrl || ''}/images/default-cover.svg`; %>
                        <img src="<%= imageSrc %>" alt="<%= book.title %>" class="w-100" style="height: 440px; object-fit: cover;" onerror="this.onerror=null;this.src='<%= baseUrl || '' %>/images/default-cover.svg';">
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card p-4">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                            <div>
                                <p class="text-uppercase text-primary fw-semibold small mb-2">Libro</p>
                                <h1 class="h2 fw-bold mb-1"><%= book.title %></h1>
                            </div>
                            <span class="book-badge <%= book.stock > 0 ? 'badge-available' : 'badge-unavailable' %>">
                                <%= book.stock > 0 ? 'En stock' : 'Sin stock' %>
                            </span>
                        </div>

                        <table class="table table-borderless align-middle">
                            <tbody>
                                <tr><th class="text-muted">ISBN</th><td><%= book.isbn %></td></tr>
                                <tr><th class="text-muted">Editorial</th><td><%= book.publisher || 'Desconocida' %></td></tr>
                                <tr><th class="text-muted">Año</th><td><%= book.publication_year || 'N/A' %></td></tr>
                                <tr><th class="text-muted">Formato</th><td><%= book.format || 'Desconocido' %></td></tr>
                                <tr><th class="text-muted">Autores</th><td><%= book.authors || 'Desconocidos' %></td></tr>
                                <tr><th class="text-muted">Géneros</th><td><%= book.genres || 'General' %></td></tr>
                                <tr><th class="text-muted">Precio</th><td class="price-tag">$<%= Number(book.price || 0).toFixed(2) %></td></tr>
                                <tr><th class="text-muted">Stock</th><td><%= book.stock || 0 %> unidades</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <% if (book.description) { %>
                <div class="card mt-4 p-4">
                    <h2 class="h4 fw-bold mb-3">Descripción</h2>
                    <p class="mb-0 text-secondary"><%= book.description %></p>
                </div>
            <% } %>

            <% if (concepts && concepts.length > 0) { %>
                <div class="card mt-4 p-4">
                    <h2 class="h4 fw-bold mb-3">Conceptos clave</h2>
                    <div class="accordion" id="conceptsAccordion">
                        <% concepts.forEach((concept, index) => { %>
                            <div class="accordion-item">
                                <h3 class="accordion-header" id="heading<%= index %>">
                                    <button class="accordion-button <%= index === 0 ? '' : 'collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>">
                                        <%= concept.concept_name %>
                                    </button>
                                </h3>
                                <div id="collapse<%= index %>" class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>" data-bs-parent="#conceptsAccordion">
                                    <div class="accordion-body"><%= concept.definition %></div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>
        </div>
    </main>
    <%- include('../footer') %>
    <script src="http://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= baseUrl || '' %>/js/script.js"></script>
</body>
</html>
