<%- include('../layout') %>

<div class="row">
    <div class="col-12">
        <a href="/books/catalog" class="btn btn-secondary mb-3">← Back to Catalog</a>
        <h2><%= book.title %></h2>
        <hr>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <% if (book.images && book.images.length > 0) { %>
            <img src="<%= book.images[0].image_url %>" alt="<%= book.images[0].alt_text %>" class="img-fluid mb-3" style="max-height: 400px;">
        <% } else { %>
            <div class="bg-light p-5 text-center mb-3">
                <p class="text-muted">No image available</p>
            </div>
        <% } %>
    </div>

    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Book Information</h5>
                <table class="table table-sm">
                    <tr>
                        <td><strong>ISBN:</strong></td>
                        <td><%= book.isbn %></td>
                    </tr>
                    <tr>
                        <td><strong>Publisher:</strong></td>
                        <td><%= book.publisher || 'Unknown' %></td>
                    </tr>
                    <tr>
                        <td><strong>Year:</strong></td>
                        <td><%= book.publication_year || 'N/A' %></td>
                    </tr>
                    <tr>
                        <td><strong>Format:</strong></td>
                        <td><%= book.format || 'Unknown' %></td>
                    </tr>
                    <tr>
                        <td><strong>Price:</strong></td>
                        <td><strong>$<%= parseFloat(book.price).toFixed(2) %></strong></td>
                    </tr>
                    <tr>
                        <td><strong>Stock:</strong></td>
                        <td>
                            <% if (book.stock > 0) { %>
                                <span class="badge bg-success"><%= book.stock %> in stock</span>
                            <% } else { %>
                                <span class="badge bg-danger">Out of stock</span>
                            <% } %>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Authors:</strong></td>
                        <td><%= book.authors || 'Unknown' %></td>
                    </tr>
                    <tr>
                        <td><strong>Genres:</strong></td>
                        <td><%= book.genres || 'Unknown' %></td>
                    </tr>
                </table>
            </div>
        </div>

        <% if (book.description) { %>
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Description</h5>
                    <p><%= book.description %></p>
                </div>
            </div>
        <% } %>
    </div>
</div>

<% if (concepts && concepts.length > 0) { %>
    <div class="row mt-4">
        <div class="col-12">
            <h3>Key Concepts</h3>
            <div class="accordion" id="conceptsAccordion">
                <% concepts.forEach((concept, index) => { %>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading<%= index %>">
                            <button class="accordion-button<% if (index !== 0) { %> collapsed<% } %>" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>">
                                <%= concept.concept_name %>
                            </button>
                        </h2>
                        <div id="collapse<%= index %>" class="accordion-collapse collapse<% if (index === 0) { %> show<% } %>" data-bs-parent="#conceptsAccordion">
                            <div class="accordion-body">
                                <%= concept.definition %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>
<% } %>

</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
