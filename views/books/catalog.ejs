<%- include('../layout') %>

<div class="row">
    <div class="col-12">
        <h2>Book Catalog</h2>
        <hr>
    </div>
</div>

<div class="row">
    <% if (books.length === 0) { %>
        <div class="col-12">
            <div class="alert alert-info">No books available at the moment.</div>
        </div>
    <% } else { %>
        <% books.forEach(book => { %>
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title"><%= book.title %></h5>
                        <p class="card-text text-muted">
                            <small><strong>ISBN:</strong> <%= book.isbn %></small><br>
                            <small><strong>Year:</strong> <%= book.publication_year || 'N/A' %></small>
                        </p>
                        <p class="card-text">
                            <strong>Price:</strong> $<%= parseFloat(book.price).toFixed(2) %><br>
                            <strong>Stock:</strong> <%= book.stock %>
                        </p>
                        <p class="card-text text-muted">
                            <small><strong>Authors:</strong> <%= book.authors || 'Unknown' %></small>
                        </p>
                    </div>
                    <div class="card-footer bg-white">
                        <a href="/books/detail/<%= book.isbn %>" class="btn btn-sm btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } %>
</div>

<% if (totalPages > 1) { %>
    <div class="row mt-4">
        <div class="col-12">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <% if (page > 1) { %>
                        <li class="page-item">
                            <a class="page-link" href="/books/catalog?page=1">First</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="/books/catalog?page=<%= page - 1 %>">Previous</a>
                        </li>
                    <% } %>

                    <li class="page-item active">
                        <span class="page-link">Page <%= page %> of <%= totalPages %></span>
                    </li>

                    <% if (page < totalPages) { %>
                        <li class="page-item">
                            <a class="page-link" href="/books/catalog?page=<%= page + 1 %>">Next</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="/books/catalog?page=<%= totalPages %>">Last</a>
                        </li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </div>
<% } %>

</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
