<!DOCTYPE html>
<html lang="es" data-base-url="<%= baseUrl || '' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Catálogo de libros' %></title>
    <link rel="preconnect" href="http://fonts.googleapis.com">
    <link rel="preconnect" href="http://fonts.gstatic.com" crossorigin>
    <link href="http://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="http://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="http://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="<%= baseUrl || '' %>/css/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="main-shell">
        <div class="container">
            <div class="hero-panel">
                <div class="row align-items-center g-4">
                    <div class="col-lg-7">
                        <p class="text-uppercase fw-semibold mb-2 text-primary-emphasis">Biblioteca universitaria</p>
                        <h1>Descubre libros para aprender, crear y crecer.</h1>
                    </div>
                    <div class="col-lg-5">
                        <form method="GET" action="<%= baseUrl || '' %>/books/search" class="search-box" id="catalogSearchForm">
                            <label class="form-label text-white-50 mb-2">Buscar por título o ISBN</label>
                            <div class="input-group">
                                <input id="searchInput" type="text" name="q" class="form-control search-box" placeholder="Ej. Clean Code, 9780132350884" aria-label="Buscar libro">
                                <button class="btn btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Buscar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <% if (books && books.length === 0) { %>
                    <div class="col-12">
                        <div class="alert alert-info">No hay libros disponibles en este momento.</div>
                    </div>
                <% } else { %>
                    <% books.forEach(book => { %>
                        <div class="col-md-6 col-xl-4">
                            <article class="card book-card h-100">
                                <div class="card-body p-0">
                                    <% const imageUrl = book.images && book.images.length ? book.images[0].image_url : ''; const imageSrc = imageUrl && /^https?:\/\//i.test(imageUrl) ? imageUrl.replace(/^https:/i, 'http:') : imageUrl ? `${baseUrl || ''}${imageUrl.startsWith('/') ? '' : '/'}${imageUrl}` : `${baseUrl || ''}/images/default-cover.svg`; %>
                                    <img src="<%= imageSrc %>" alt="<%= book.title %>" class="book-cover w-100" onerror="this.onerror=null;this.src='<%= baseUrl || '' %>/images/default-cover.svg';">
                                    <div class="p-3">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                            <span class="book-badge badge-category"><%= book.genres || 'General' %></span>
                                            <span class="book-badge <%= book.stock > 0 ? 'badge-available' : 'badge-unavailable' %>">
                                                <%= book.stock > 0 ? 'Disponible' : 'Sin stock' %>
                                            </span>
                                        </div>
                                        <h3 class="h5 fw-bold mb-2"><%= book.title %></h3>
                                        <p class="text-muted small mb-2"><strong>ISBN:</strong> <%= book.isbn %></p>
                                        <p class="text-muted small mb-3"><strong>Autores:</strong> <%= book.authors || 'Desconocidos' %></p>
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="price-tag">$<%= Number(book.price || 0).toFixed(2) %></span>
                                            <small class="text-muted">Stock: <%= book.stock || 0 %></small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-white border-0 p-3 pt-0">
                                    <div class="d-flex gap-2">
                                        <a href="<%= baseUrl || '' %>/books/detail/<%= encodeURIComponent(book.isbn) %>" class="btn btn-primary flex-grow-1">Ver detalle</a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    <% }); %>
                <% } %>
            </div>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <nav aria-label="Paginación de libros" class="mt-5">
                    <ul class="pagination justify-content-center">
                        <% if (page > 1) { %>
                            <li class="page-item"><a class="page-link" href="<%= baseUrl || '' %>/books/catalog?page=<%= page - 1 %>">Anterior</a></li>
                        <% } %>
                        <li class="page-item active"><span class="page-link">Página <%= page %> de <%= totalPages %></span></li>
                        <% if (page < totalPages) { %>
                            <li class="page-item"><a class="page-link" href="<%= baseUrl || '' %>/books/catalog?page=<%= page + 1 %>">Siguiente</a></li>
                        <% } %>
                    </ul>
                </nav>
            <% } %>
        </div>
    </main>
    <%- include('../footer') %>
    <script src="http://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= baseUrl || '' %>/js/script.js"></script>
</body>
</html>
