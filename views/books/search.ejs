<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Buscar libros' %></title>
    <link rel="preconnect" href="//fonts.googleapis.com">
    <link rel="preconnect" href="//fonts.gstatic.com" crossorigin>
    <link href="//fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="//cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="main-shell">
        <div class="container">
            <div class="hero-panel mb-4">
                <h1 class="mb-3">Buscar libros</h1>
                <form method="GET" action="/books/search" class="row g-3 align-items-end">
                    <div class="col-lg-6">
                        <label class="form-label text-white-50">Término de búsqueda</label>
                        <input type="text" class="form-control" name="q" value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>" placeholder="Título, autor o ISBN">
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label text-white-50">Precio mínimo</label>
                        <input type="number" class="form-control" name="minPrice" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>">
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label text-white-50">Precio máximo</label>
                        <input type="number" class="form-control" name="maxPrice" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>">
                    </div>
                    <div class="col-md-12 col-lg-2">
                        <button type="submit" class="btn btn-primary w-100">Buscar</button>
                    </div>
                </form>
            </div>

            <% if (typeof searchTerm === 'undefined' || searchTerm.trim() === '') { %>
                <div class="alert alert-info">Introduce un término para encontrar libros.</div>
            <% } else if (books.length === 0) { %>
                <div class="alert alert-warning">No se encontraron resultados para tu búsqueda.</div>
            <% } else { %>
                <div class="row g-4">
                    <% books.forEach(book => { %>
                        <div class="col-md-6 col-xl-4">
                            <article class="card book-card h-100">
                                <div class="card-body p-0">
                                    <img src="<%= book.images && book.images.length ? book.images[0].image_url : 'https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=900&q=80' %>" alt="<%= book.title %>" class="book-cover w-100">
                                    <div class="p-3">
                                        <h3 class="h5 fw-bold mb-2"><%= book.title %></h3>
                                        <p class="text-muted small mb-2"><strong>ISBN:</strong> <%= book.isbn %></p>
                                        <p class="text-muted small mb-3"><strong>Autor:</strong> <%= book.authors || 'Desconocido' %></p>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="price-tag">$<%= Number(book.price || 0).toFixed(2) %></span>
                                            <span class="book-badge <%= book.stock > 0 ? 'badge-available' : 'badge-unavailable' %>"><%= book.stock > 0 ? 'Disponible' : 'Sin stock' %></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-white border-0 p-3 pt-0">
                                    <a href="/books/detail/<%= book.isbn %>" class="btn btn-primary w-100">Ver detalle</a>
                                </div>
                            </article>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </main>
    <%- include('../footer') %>
    <script src="//cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>
</body>
</html>
