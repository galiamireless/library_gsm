<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="error-card">
                <div class="error-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <p class="error-kicker">Error <%= typeof error !== 'undefined' && error && error.status ? error.status : '500' %></p>
                <h1 class="error-title">
                    <%= typeof message !== 'undefined' && message ? message : 'Ha ocurrido un error' %>
                </h1>
                <p class="error-message">
                    <%= typeof error !== 'undefined' && error && error.details ? error.details : 'La página solicitada no está disponible en este momento.' %>
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center">
                    <a href="<%= baseUrl || '' %>/books/catalog" class="btn btn-primary btn-lg">
                        <i class="fa-solid fa-book-open me-2"></i>Ir al catálogo
                    </a>
                    <a href="<%= baseUrl || '' %>/auth/login" class="btn btn-outline-secondary btn-lg">
                        <i class="fa-solid fa-right-to-bracket me-2"></i>Iniciar sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
