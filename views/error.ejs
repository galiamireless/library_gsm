<%- include('./layout') %>

<div class="row mt-5">
    <div class="col-md-8 offset-md-2">
        <div class="card border-danger">
            <div class="card-body">
                <h4 class="card-title text-danger">
                    <% if (error && error.status === 404) { %>
                        404 - Not Found
                    <% } else if (error && error.status === 403) { %>
                        403 - Access Denied
                    <% } else if (error && error.status === 401) { %>
                        401 - Unauthorized
                    <% } else { %>
                        Error
                    <% } %>
                </h4>
                <h5 class="card-subtitle mb-2"><%= message %></h5>
                <p class="card-text"><%= error ? error.details : 'An unexpected error occurred' %></p>
                <a href="/books/catalog" class="btn btn-primary">Return to Catalog</a>
            </div>
        </div>
    </div>
</div>

</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
