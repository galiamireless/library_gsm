<!DOCTYPE html>
<html lang="es" data-base-url="<%= baseUrl || '' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard administrador</title>
    <link rel="preconnect" href="http://fonts.googleapis.com">
    <link rel="preconnect" href="http://fonts.gstatic.com" crossorigin>
    <link href="http://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="http://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="http://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="<%= baseUrl || '' %>/css/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="main-shell">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <p class="text-uppercase text-primary fw-semibold small mb-1">Administración</p>
                    <h1 class="h2 fw-bold mb-0">Dashboard</h1>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-3">
                    <div class="card text-center p-3">
                        <div class="card-body">
                            <h2 class="h6 text-muted">Total de libros</h2>
                            <p class="display-5 fw-bold mb-0"><%= stats.total_books || 0 %></p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center p-3">
                        <div class="card-body">
                            <h2 class="h6 text-muted">Stock total</h2>
                            <p class="display-5 fw-bold mb-0"><%= stats.total_stock || 0 %></p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center p-3">
                        <div class="card-body">
                            <h2 class="h6 text-muted">Disponibles</h2>
                            <p class="display-5 fw-bold mb-0"><%= stats.available_count || 0 %></p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center p-3">
                        <div class="card-body">
                            <h2 class="h6 text-muted">Sin stock</h2>
                            <p class="display-5 fw-bold mb-0"><%= stats.out_of_stock_count || 0 %></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mt-1">
                <div class="col-md-4">
                    <div class="card p-3">
                        <h3 class="h6 text-muted">Precio promedio</h3>
                        <p class="display-6 fw-bold mb-0">$<%= stats.avg_price ? parseFloat(stats.avg_price).toFixed(2) : '0.00' %></p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-3">
                        <h3 class="h6 text-muted">Precio mínimo</h3>
                        <p class="display-6 fw-bold mb-0">$<%= stats.min_price ? parseFloat(stats.min_price).toFixed(2) : '0.00' %></p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-3">
                        <h3 class="h6 text-muted">Precio máximo</h3>
                        <p class="display-6 fw-bold mb-0">$<%= stats.max_price ? parseFloat(stats.max_price).toFixed(2) : '0.00' %></p>
                    </div>
                </div>
            </div>

            <div class="card mt-4 p-4">
                <h2 class="h5 fw-bold mb-3">Acciones rápidas</h2>
                <div class="d-flex flex-wrap gap-2">
                    <a href="<%= baseUrl || '' %>/admin/books/new" class="btn btn-primary">Agregar libro</a>
                    <a href="<%= baseUrl || '' %>/admin/concepts" class="btn btn-outline-secondary">Gestionar conceptos</a>
                    <a href="<%= baseUrl || '' %>/admin/users" class="btn btn-outline-primary">Gestionar usuarios</a>
                </div>
            </div>
        </div>
    </main>
    <%- include('../footer') %>
    <script src="http://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= baseUrl || '' %>/js/script.js"></script>
</body>
</html>
