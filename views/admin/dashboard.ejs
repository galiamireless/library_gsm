<%- include('../layout') %>

<div class="row">
    <div class="col-12">
        <h2>Admin Dashboard</h2>
        <hr>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Total Books</h5>
                <p class="card-text display-4"><%= stats.total_books || 0 %></p>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Total Stock</h5>
                <p class="card-text display-4"><%= stats.total_stock || 0 %></p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Available</h5>
                <p class="card-text display-4"><%= stats.available_count || 0 %></p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Out of Stock</h5>
                <p class="card-text display-4"><%= stats.out_of_stock_count || 0 %></p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Average Price</h5>
                <p class="card-text display-5">$<%= stats.avg_price ? parseFloat(stats.avg_price).toFixed(2) : '0.00' %></p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Min Price</h5>
                <p class="card-text display-5">$<%= stats.min_price ? parseFloat(stats.min_price).toFixed(2) : '0.00' %></p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Max Price</h5>
                <p class="card-text display-5">$<%= stats.max_price ? parseFloat(stats.max_price).toFixed(2) : '0.00' %></p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Management Options</h5>
                <a href="/admin/books/new" class="btn btn-primary">Add New Book</a>
                <a href="/admin/concepts" class="btn btn-secondary">Manage Concepts</a>
            </div>
        </div>
    </div>
</div>

</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
