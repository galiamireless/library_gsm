<!DOCTYPE html>
<html lang="es" data-base-url="<%= baseUrl || '' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Libro' %> | Library UDEM</title>
    <link rel="preconnect" href="http://fonts.googleapis.com">
    <link rel="preconnect" href="http://fonts.gstatic.com" crossorigin>
    <link href="http://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="http://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="http://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="<%= baseUrl || '' %>/css/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="main-shell">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <p class="text-uppercase text-primary fw-semibold small mb-2">Administración</p>
                    <h1 class="h2 fw-bold mb-0"><%= book ? 'Editar libro' : 'Nuevo libro' %></h1>
                </div>
                <a href="<%= baseUrl || '' %>/admin/dashboard" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Dashboard</a>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger" role="alert"><%= error %></div>
            <% } %>

            <form method="POST" action="<%= baseUrl || '' %><%= book ? '/admin/books/' + encodeURIComponent(book.isbn) : '/admin/books' %>" class="card p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="isbn" class="form-label">ISBN</label>
                        <input id="isbn" name="isbn" class="form-control" value="<%= book ? book.isbn : '' %>" <%= book ? 'readonly' : 'required' %>>
                    </div>
                    <div class="col-md-6">
                        <label for="title" class="form-label">Título</label>
                        <input id="title" name="title" class="form-control" value="<%= book ? book.title : '' %>" required>
                    </div>
                    <div class="col-12">
                        <label for="description" class="form-label">Descripción</label>
                        <textarea id="description" name="description" class="form-control" rows="4"><%= book ? book.description || '' : '' %></textarea>
                    </div>
                    <div class="col-md-4">
                        <label for="publication_year" class="form-label">Año de publicación</label>
                        <input id="publication_year" name="publication_year" type="number" class="form-control" value="<%= book ? book.publication_year || '' : '' %>">
                    </div>
                    <div class="col-md-4">
                        <label for="price" class="form-label">Precio</label>
                        <input id="price" name="price" type="number" min="0" step="0.01" class="form-control" value="<%= book ? book.price || '' : '' %>" required>
                    </div>
                    <div class="col-md-4">
                        <label for="stock" class="form-label">Stock</label>
                        <input id="stock" name="stock" type="number" min="0" class="form-control" value="<%= book ? book.stock || 0 : 0 %>" required>
                    </div>
                    <div class="col-md-4">
                        <label for="format_id" class="form-label">Formato</label>
                        <select id="format_id" name="format_id" class="form-select">
                            <option value="">Seleccionar formato</option>
                            <% (formats || []).forEach((format) => { %>
                                <option value="<%= format.format_id %>" <%= book && String(book.format_id) === String(format.format_id) ? 'selected' : '' %>><%= format.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="format_type" class="form-label">Tipo de edición</label>
                        <select id="format_type" name="format_type" class="form-select">
                            <option value="PHYSICAL" <%= book && book.format_type === 'PHYSICAL' ? 'selected' : '' %>>Físico</option>
                            <option value="DIGITAL" <%= book && book.format_type === 'DIGITAL' ? 'selected' : '' %>>Digital</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="digital_format" class="form-label">Formato digital</label>
                        <select id="digital_format" name="digital_format" class="form-select">
                            <option value="">--</option>
                            <option value="PDF" <%= book && book.digital_format === 'PDF' ? 'selected' : '' %>>PDF</option>
                            <option value="EPUB" <%= book && book.digital_format === 'EPUB' ? 'selected' : '' %>>EPUB</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="publisher" class="form-label">Editorial</label>
                        <input id="publisher" name="publisher" class="form-control" value="<%= book ? book.publisher || '' : '' %>">
                    </div>
                    <div class="col-md-6">
                        <label for="image_url" class="form-label">URL de portada</label>
                        <input id="image_url" name="image_url" class="form-control" placeholder="https://... o /uploads/..." value="">
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="<%= baseUrl || '' %>/admin/dashboard" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Guardar libro</button>
                </div>
            </form>

            <% if (book) { %>
                <div class="card p-4 mt-4">
                    <h2 class="h5 fw-bold mb-3">Portada del libro</h2>
                    <form method="POST" action="<%= baseUrl || '' %>/admin/books/<%= encodeURIComponent(book.isbn) %>/upload-image" enctype="multipart/form-data" class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label">Archivo de imagen</label>
                            <input type="file" name="image" class="form-control" accept="image/jpeg,image/png,image/webp">
                            <small class="text-muted">Permitido: JPG, PNG y WebP (máx. 2 MB)</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ruta o URL de portada</label>
                            <input type="url" name="image_url" class="form-control" placeholder="https://example.com/cover.jpg o /uploads/cover.jpg">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Texto alternativo</label>
                            <input type="text" name="alt_text" class="form-control" value="<%= book.title %>">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Portada</label>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" name="is_cover" value="true" checked>
                                <label class="form-check-label">Marcar como portada</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Subir portada</button>
                        </div>
                    </form>
                </div>
            <% } %>
        </div>
    </main>
    <%- include('../footer') %>
    <script src="http://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= baseUrl || '' %>/js/script.js"></script>
</body>
</html>
