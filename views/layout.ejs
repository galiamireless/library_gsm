<div class="row justify-content-center my-5">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-danger text-white py-3 text-center border-0">
                <i class="fa-solid fa-triangle-exclamation fa-3x mb-2"></i>
                <h3 class="fw-bold mb-0">Error en el Sistema</h3>
            </div>
            <div class="card-body p-4 text-center">
                <h4 class="text-dark fw-semibold mb-3">
                    <%= typeof message !== 'undefined' ? message : 'El recurso solicitado no fue encontrado o la ruta es inválida.' %>
                </h4>
                <p class="text-muted small mb-4">
                    <%= typeof error !== 'undefined' && error.status ? 'Código HTTP: ' + error.status : 'Asegúrate de que la URL introducida sea correcta.' %>
                </p>
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a href="/books" class="btn btn-primary btn-lg px-4 gap-3 rounded-pill fw-semibold shadow-sm">
                        <i class="fa-solid fa-book-open me-2"></i>Ir al Catálogo
                    </a>
                    <a href="/auth/login" class="btn btn-outline-secondary btn-lg px-4 rounded-pill fw-semibold">
                        <i class="fa-solid fa-right-to-bracket me-2"></i>Iniciar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>