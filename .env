# ===================================================================
# Variables de entorno para la aplicación de librería
# ===================================================================

NODE_ENV=development
PORT=3000
APP_NAME=Library Management System

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gsm_library_db
DB_USER=lib_gsm_user
DB_PASSWORD=lib_gsm_user666

DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=1000

SESSION_SECRET=your_very_secure_session_secret_here_change_me
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_MAX_AGE=86400000

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=2097152
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

LOG_LEVEL=info
LOG_FORMAT=combined

BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000

GCP_PROJECT_ID=
GCP_REGION=us-central1

EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=

DEBUG=false
VERBOSE=false
