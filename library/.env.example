# ===================================================================
# Plantilla de Variables de Entorno - NO incluye credenciales reales
# Copiar a .env y completar con valores reales
# ===================================================================

# Configuración de Node.js
NODE_ENV=development
PORT=3000
APP_NAME=Library Management System

# Configuración de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gsm_library_db
DB_USER=lib_gsm_user
DB_PASSWORD=lib_gsm_user666

# Configuración de Pool de Conexiones
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=1000

# Configuración de Sesiones
SESSION_SECRET=your_very_secure_session_secret_here_change_me
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_MAX_AGE=86400000

# Configuración de Archivos (Uploads)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=2097152
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Configuración de Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Configuración de Seguridad
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000

# Configuración de GCP (opcional, para despliegue futuro)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Configuración de Email (opcional)
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your_sendgrid_api_key

# Debugging
DEBUG=false
VERBOSE=false
